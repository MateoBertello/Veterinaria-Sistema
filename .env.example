# Supabase Project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Sentry (opcional en desarrollo)
SENTRY_DSN=

# Notificaciones por email (Resend)
# RESEND_API_KEY: clave de API (empieza con re_). NOTIF_FROM_EMAIL: remitente.
# Para pruebas sin dominio propio usar "Nombre <onboarding@resend.dev>".
RESEND_API_KEY=
NOTIF_FROM_EMAIL=

# Tests de integración (puede ser mismo proyecto o uno de staging)
TEST_SUPABASE_URL=https://<project-ref>.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>