# Supabase Project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Sentry (opcional en desarrollo)
SENTRY_DSN=

# Notificaciones por email (Resend)
# RESEND_API_KEY: clave de API (empieza con re_). NOTIF_FROM_EMAIL: remitente.
# Para pruebas sin dominio propio usar "Nombre <onboarding@resend.dev>".
RESEND_API_KEY=
NOTIF_FROM_EMAIL=

# Cron de notificaciones (Etapa 9 — RN-NT5). Secreto que valida el endpoint interno
# POST /internal/notificaciones/procesar. El MISMO valor debe cargarse en Vault como
# 'cron_notif_secret' para que pg_cron/pg_net lo mande en el header X-Cron-Secret.
CRON_SECRET=

# Tests de integración (puede ser mismo proyecto o uno de staging)
TEST_SUPABASE_URL=https://<project-ref>.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>